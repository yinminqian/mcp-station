expr -l objc -O -- @import AppKit; NSWindow *w = nil; for (NSWindow *x in (NSArray *)[(NSApplication *)NSApp windows]) { if ([x isVisible] && [x canBecomeMainWindow]) { w = x; break; } } NSView *root = [(NSView *)[w contentView] superview]; if (!root) { root = (NSView *)[w contentView]; } NSMutableArray *stack = [NSMutableArray arrayWithObject:root]; NSMutableString *out = [NSMutableString stringWithString:@"HIDDENROOTS\n"]; int total = 0; int roots = 0; int under = 0; while ([stack count]) { NSView *v = (NSView *)[stack lastObject]; [stack removeLastObject]; total++; CALayer *l = (CALayer *)[v layer]; BOOL inv = (BOOL)[v isHidden] || (double)[v alphaValue] < 0.01 || (l && (float)[l opacity] < 0.01); if (inv) { roots++; NSMutableArray *s2 = [NSMutableArray arrayWithObject:v]; int n = 0; int tables = 0; int switches = 0; while ([s2 count]) { NSView *u = (NSView *)[s2 lastObject]; [s2 removeLastObject]; n++; if ([u isKindOfClass:[NSTableView class]]) tables++; if ([u isKindOfClass:[NSSwitch class]]) switches++; [s2 addObjectsFromArray:(NSArray *)[u subviews]]; } under += n; NSRect f = (NSRect)[v frame]; [out appendFormat:@"invisible root %@ hidden=%d alpha=%.2f layerOpacity=%.2f frame=%.0fx%.0f descendants=%d tables=%d switches=%d\n", NSStringFromClass([v class]), (int)(BOOL)[v isHidden], (double)[v alphaValue], l ? (float)[l opacity] : -1.0f, f.size.width, f.size.height, n, tables, switches]; } else { [stack addObjectsFromArray:(NSArray *)[v subviews]]; } } [out appendFormat:@"total visible-chain views visited=%d invisible roots=%d views under invisible roots=%d\n", total, roots, under]; out
detach
quit
