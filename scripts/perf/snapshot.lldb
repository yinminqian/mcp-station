expr -l objc -O -- @import AppKit; NSWindow *snapWin = nil; for (NSWindow *snapX in (NSArray *)[(NSApplication *)NSApp windows]) { if ([snapX isVisible] && [snapX canBecomeMainWindow]) { snapWin = snapX; break; } } NSView *snapView = [(NSView *)[snapWin contentView] superview]; if (!snapView) { snapView = (NSView *)[snapWin contentView]; } NSRect snapRect = (NSRect)[snapView bounds]; NSBitmapImageRep *snapRep = (NSBitmapImageRep *)[snapView bitmapImageRepForCachingDisplayInRect:snapRect]; [snapView cacheDisplayInRect:snapRect toBitmapImageRep:snapRep]; NSData *snapData = (NSData *)[snapRep representationUsingType:(NSBitmapImageFileType)4 properties:@{}]; BOOL snapOK = (BOOL)[snapData writeToFile:@"__PNG__" atomically:YES]; [NSString stringWithFormat:@"SNAPSHOT ok=%d size=%.0fx%.0f bytes=%lu", (int)snapOK, snapRect.size.width, snapRect.size.height, (unsigned long)[snapData length]]
detach
quit
