expr -l objc -O -- @import AppKit; NSWindow *w = nil; for (NSWindow *x in (NSArray *)[(NSApplication *)NSApp windows]) { if ([x isVisible] && [x canBecomeMainWindow]) { w = x; break; } } NSView *root = [(NSView *)[w contentView] superview]; if (!root) { root = (NSView *)[w contentView]; } NSRect b = (NSRect)[root bounds]; NSMutableString *out = [NSMutableString stringWithFormat:@"HITMAP window=%@ size=%.0fx%.0f\n", [w title], b.size.width, b.size.height]; for (int iy = 0; iy < 32; iy++) { for (int ix = 0; ix < 48; ix++) { NSPoint p = NSMakePoint(b.origin.x + (ix + 0.5) * b.size.width / 48, b.origin.y + (iy + 0.5) * b.size.height / 32); NSView *hit = (NSView *)[root hitTest:p]; NSView *v = hit; NSString *inv = @"-"; while (v) { CALayer *l = (CALayer *)[v layer]; if ((BOOL)[v isHidden] || (double)[v alphaValue] < 0.01 || (l && (float)[l opacity] < 0.01)) { inv = NSStringFromClass([v class]); break; } v = (NSView *)[v superview]; } [out appendFormat:@"%d,%d,%@,%@\n", ix, iy, hit ? NSStringFromClass([hit class]) : @"nil", inv]; } } out
detach
quit
